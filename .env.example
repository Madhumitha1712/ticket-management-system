# Environment Configuration Template
NODE_ENV=development
PORT=5000

# MongoDB Atlas / Local Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fsd_ticket_system?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_ticket_system_2026_enterprise_production
JWT_EXPIRE=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Multer Uploads Directory
UPLOAD_PATH=uploads

# System Default SLA settings (Minutes)
CRITICAL_RESPONSE_MIN=15
CRITICAL_RESOLUTION_MIN=120
HIGH_RESPONSE_MIN=30
HIGH_RESOLUTION_MIN=240
MEDIUM_RESPONSE_MIN=120
MEDIUM_RESOLUTION_MIN=720
LOW_RESPONSE_MIN=240
LOW_RESOLUTION_MIN=1440
